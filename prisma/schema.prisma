// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======== USER MODEL ========
model User {
  id          Int      @id @default(autoincrement())
  email       String?  @unique
  password    String
  token       String?
  reftoken    String?
  type        Int?     @default(1) // CLIENT 2 OPERADOR 1 ADMIN 0
  isActive    Boolean
  status      Int      // 0: Inactivo, 1: Activo
  persona     Persona? 
  menuUser    MenuUser[]
  moduleUser  ModuleUser[]
  permissionsUser PermissionsUser[]
  roleId      Int?
  role        Role?     @relation(fields: [roleId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Persona {
  id              Int      @id @default(autoincrement())
  ci              String?
  firstName       String?
  lastName        String?
  phone           String?
  address         String?
  status          Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  cityId          Int?
  userId          Int?     @unique
  user            User?    @relation(fields: [userId], references: [id])
  city            City?    @relation(fields: [cityId], references: [id])
  clients         Clients[]
  operators       Operator[]
  legalEntities   Legal_Entity[]
  providers       Provider[]
}


model Operator {
  id                Int      @id @default(autoincrement())
  registrationDate  DateTime
  isActive          Boolean  @default(true)
  isIntern          Boolean  @default(true)
  status            Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  personId          Int
  branchOfficeId    Int?
  person            Persona  @relation(fields: [personId], references: [id])
  
  branch_office     Branch_Office? @relation(fields: [branchOfficeId], references: [id])
}

model Role {
  id          Int @id @default(autoincrement())
  name        String?
  status      Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Module {
  id          Int @id @default(autoincrement())
  name        String?
  status      Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  moduleMenu  ModuleMenu[]
  modeloUsers ModuleUser[] 
}

model ModuleUser {
  id        Int @id @default(autoincrement())
  status    Int @default(1)
  moduleId  Int? 
  userId    Int? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  modules   Module? @relation(fields: [moduleId] , references: [id])
  users     User? @relation(fields: [userId] , references: [id])
  @@unique([moduleId , userId ])
}
model Menu {
  id            Int @id @default(autoincrement())
  name          String?
  status        Int @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  menuUser      MenuUser[]
  menuPermissions MenuPermissions[]
  moduleMenus   ModuleMenu[]
}

model ModuleMenu {
  id          Int @id @default(autoincrement())
  moduleId    Int
  menuId      Int
  status      Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  module      Module @relation(fields: [moduleId], references: [id])
  menu        Menu? @relation(fields: [menuId], references: [id])
}

model Permissions {
  id            Int @id @default(autoincrement())
  name          String?
  status        Int @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  menuPermissions MenuPermissions[]
  permissionsUser PermissionsUser[]
}

model MenuUser {
  id          Int @id @default(autoincrement())
  userId      Int
  menuId      Int
  status      Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User? @relation(fields: [userId], references: [id])
  menu        Menu @relation(fields: [menuId], references: [id])
  @@unique([userId, menuId])
}

model MenuPermissions {
  id             Int @id @default(autoincrement())
  menuId         Int
  permissionsId  Int
  status         Int @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  menu           Menu @relation(fields: [menuId], references: [id])
  permissions    Permissions @relation(fields: [permissionsId], references: [id])
}

model PermissionsUser {
  id            Int @id @default(autoincrement())
  userId        Int 
  permissionsId Int
  status        Int @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User @relation(fields: [userId], references: [id])
  permissions   Permissions @relation(fields: [permissionsId], references: [id])
  @@unique([userId, permissionsId]) 
}
//-------------------------------------------------------------------------------------

model Legal_Entity {
  id  Int @id @default(autoincrement())
  NIT               String?
  companyName       String?
  address           String?
  registrationDate  DateTime
  legalRepresentive String?
  typeCompany       String?
  status            Int @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  personId          Int
  persona           Persona @relation(fields: [personId] , references: [id])
}

model City {
  id          Int @id   @default(autoincrement())
  description String  @unique
  person      Persona[]
  branchOffice Branch_Office[]
}

model Branch_Office {
  id          Int @id @default(autoincrement())
  name        String?
  address     String?
  phone       String?
  email       String?
  cityId      Int?
  city        City? @relation(fields: [cityId], references: [id])
  status      Int
  operator    Operator[]
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
}
//-------------------------------------------------------------------

model Provider {
  id          Int @id @default(autoincrement())
  NIT         String?
  cellphone   String?
  email       String
  typeProvider  String?
  isActive    Boolean
  status      Int
  personId    Int
  person      Persona? @relation(fields: [personId] , references: [id])
  createAt    DateTime @default(now())
  updateAt    DateTime @updatedAt
}

model Clients {
  id        Int      @id @default(autoincrement())
  email     String
  cellphone String?
  NIT       String
  isIntern  Boolean
  isActive  Boolean
  status    Int
  personId  Int
  person    Persona  @relation(fields: [personId], references: [id])
  createdAt DateTime @default(now())  // Corregido
  updatedAt DateTime @updatedAt       // Corregido
}