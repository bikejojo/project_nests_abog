// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======== USER MODEL ========
model User {
  id        Int   @id @default(autoincrement())
  email     String   
  name      String
  role      String   // EMPRESA , ABOGADO
  password  String
  token     String  // Optional token for password reset
  type      Int   // CLIENTE, ABOGADO, EMPRESA
  isActive  Boolean
  status    Int   // 0: Inactivo, 1: Activo
  company   Company?
  lawyer    Lawyer?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id        Int   @id @default(autoincrement())
  name      String
  email     String
  phone     String
  address   String
  userId    Int   @unique
  status    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Lawyer {
  id        Int   @id @default(autoincrement())
  firstName String
  lastName  String
  email     String
  phone     String
  address   String
  userId    Int   @unique
  status    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Provider {
  id Int @id @default(autoincrement())
  firstName String
  lastName  String
  NIT       String
  phone     String
  email     String
  address   String
  typeProvider  String?
  isActive  Boolean
  createAt  DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Clients {
  id Int @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String
  email     String
  NIT       String
  isActive  Boolean
  createAt  DateTime @default(now())
  updateAt  DateTime @updatedAt
} 