// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======== USER MODEL ========
model User {
  id        Int   @id @default(autoincrement())
  email     String   
  name      String
  role      String   // EMPRESA , ABOGADO
  password  String
  token     String  // Optional token for password reset
  type      Int   // CLIENTE, ABOGADO, EMPRESA
  isActive  Boolean
  status    Int   // 0: Inactivo, 1: Activo
  company   Company?
  lawyer    Lawyer?
  admin     Admin?
  rols      RolsUser[] // Relación con tabla pivote
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rols { 
  id          Int @id @default(autoincrement())
  description String
  status      Int  @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       RolsUser[]
  permissions PermissionsRol[]
}

model Permissions {
  id          Int @id @default(autoincrement())
  description String
  status      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       PermissionsRol[] 
}

model RolsUser {
  id        Int @id @default(autoincrement())
  rolId     Int
  userId    Int
  status    Int
  rol       Rols @relation(fields: [rolId], references: [id])
  user      User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PermissionsRol {
  id            Int @id @default(autoincrement())
  permissionId  Int
  rolId         Int
  status        Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  permission    Permissions @relation( fields: [permissionId], references: [id])
  rol           Rols        @relation( fields: [rolId], references: [id])
}

model Company {
  id        Int   @id @default(autoincrement())
  name      String
  email     String
  phone     String
  address   String
  userId    Int   @unique
  status    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Lawyer {
  id        Int   @id @default(autoincrement())
  firstName String
  lastName  String
  email     String
  phone     String
  address   String
  manager   Manager?
  lawyerUnits lawyersUnit?
  userId    Int   @unique
  status    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  
}

model Admin {
  id       Int   @id @default(autoincrement())
  name     String
  email    String
  userId   Int   @unique 
  user     User   @relation(fields: [userId], references: [id])
}

//-------------------------------------------------------------------
model lawyersUnit {
  id          Int @id @default(autoincrement())
  lawyerId    Int @unique
  unityId     Int @unique
  status      Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  unity       Unity @relation(fields: [unityId],references: [id])
  lawyer      Lawyer @relation(fields: [lawyerId],references: [id])
}


model Unity {
  id          Int @id @default(autoincrement())
  name        String
  description String?
  status      Int @default(1)
  unityDepartaments unityDepartaments?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lawyerUnit  lawyersUnit?

}

model unityDepartaments {
  id             Int @id @default(autoincrement())
  departamentsId Int @unique
  unityId        Int @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  unity          Unity @relation(fields: [unityId], references: [id])
  departaments   Departaments @relation(fields: [departamentsId], references: [id])

}

model Departaments {
  id          Int @id @default(autoincrement())
  name        String
  description String?
  status      Int
  unityDepartaments unityDepartaments?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  departamentsSubOffice DepartamentsSubOffice?
}

model DepartamentsSubOffice {
  id      Int         @id @default(autoincrement())
  departamentsId      Int @unique
  subcidiaryOfficeId  Int @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  departaments Departaments @relation(fields: [departamentsId],references: [id])
  subcidiary_office Subcidiary_office @relation(fields: [subcidiaryOfficeId],references: [id])
}

model Subcidiary_office {
  id          Int @id @default(autoincrement())
  name        String
  address     String
  phone       String?
  status      Int @default(1)
  departamentsSubOffice DepartamentsSubOffice?
  openingDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Manager {
  id          Int @id @default(autoincrement())
  name        String?
  status      Int @default(1)
  lawyerId    Int @unique
  sectorId    Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lawyer      Lawyer @relation(fields: [lawyerId], references: [id])
}


model Provider {
  id Int @id @default(autoincrement())
  firstName String
  lastName  String
  NIT       String
  phone     String
  email     String
  address   String
  typeProvider  String?
  isActive  Boolean
  status    Int
  createAt  DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Clients {
  id Int @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String
  email     String
  NIT       String
  isActive  Boolean
  status    Int
  createAt  DateTime @default(now())
  updateAt  DateTime @updatedAt
} 





model Personal_type {
  id          Int @id @default(autoincrement())
  code        String
  description String
  status      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model External_personal {
  id        Int @id @default(autoincrement())
  firstName String?
  lastName  String?
  phone     String?
  email     String?
  type      Int
  description String
  status    Int
  dateOfBirth DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}