// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======== USER MODEL ========
model User {
  id        Int   @id @default(autoincrement())
  email     String?   
  name      String @unique
  ci        String?
  password  String
  token     String  // Optional token for password reset
  type      Int?   @default(1)// ABOGADO 1  ADMIN 0
  isActive  Boolean
  status    Int   // 0: Inactivo, 1: Activo
  lawyer    Lawyer?
  menuUser  MenuUser[]
  moduleUser ModuleUser[]
  permissionsUser PermissionsUser[]
  roleId   Int?
  role     Role? @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          Int @id @default(autoincrement())
  name        String?
  status      Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Module {
  id          Int @id @default(autoincrement())
  name        String?
  status      Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  moduleMenu  ModuleMenu[]
  modeloUsers ModuleUser[] 
}

model ModuleUser {
  id        Int @id @default(autoincrement())
  status    Int @default(1)
  moduleId  Int? @unique
  userId    Int? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  modules   Module? @relation(fields: [moduleId] , references: [id])
  users     User? @relation(fields: [userId] , references: [id])
}
model Menu {
  id            Int @id @default(autoincrement())
  name          String?
  status        Int @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  menuUser      MenuUser?
  menuPermissions MenuPermissions[]
  moduleMenus   ModuleMenu[]
}

model ModuleMenu {
  id          Int @id @default(autoincrement())
  moduleId    Int
  menuId      Int
  status      Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  module      Module @relation(fields: [moduleId], references: [id])
  menu        Menu @relation(fields: [menuId], references: [id])
}

model Permissions {
  id            Int @id @default(autoincrement())
  name          String?
  status        Int @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  menuPermissions MenuPermissions[]
  permissionsUser PermissionsUser[]
}

model MenuUser {
  id          Int @id @default(autoincrement())
  userId      Int? @unique
  menuId      Int? @unique
  status      Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User? @relation(fields: [userId], references: [id])
  menu        Menu? @relation(fields: [menuId], references: [id])
}

model MenuPermissions {
  id             Int @id @default(autoincrement())
  menuId         Int
  permissionsId  Int
  status         Int @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  menu           Menu @relation(fields: [menuId], references: [id])
  permissions    Permissions @relation(fields: [permissionsId], references: [id])
}

model PermissionsUser {
  id            Int @id @default(autoincrement())
  userId        Int @unique
  permissionsId Int
  status        Int @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User @relation(fields: [userId], references: [id])
  permissions   Permissions @relation(fields: [permissionsId], references: [id])
}
//-------------------------------------------------------------------------------------

model Persona {
  id              Int @id @default(autoincrement())
  ci              String?
  firstName       String?
  lastName        String?
  phone           String?
  address         String?
  status          Int @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  cityId          Int?
  city            City?  @relation(fields: [cityId] , references: [id])
  lawyers         Lawyer[]
  judges          Judge[]
  natural_persons Natural_Person[]
  legal_entity    Legal_Entity[]
}

model Lawyer {
  id                Int @id @default(autoincrement())
  registrationDate  DateTime
  isActive          Boolean @default(true)
  isFiscal          Boolean @default(false)
  isIntern          Boolean @default(true)
  status            Int @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime  @updatedAt
  userId            Int? @unique
  personId          Int
  branchOfficeId    Int?
  persona           Persona @relation(fields: [personId] , references: [id])
  user              User? @relation(fields: [userId] ,references: [id])
  branch_office     Branch_Office? @relation(fields: [branchOfficeId] , references: [id])
}

model Judge {
  id        Int @id @default(autoincrement())
  registratioDate DateTime
  description     String?
  isActive        Boolean @default(true)
  isIntern        Boolean @default(true)
  status          Int     @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  personId        Int
  persona         Persona @relation(fields: [personId] , references: [id])
}

model Natural_Person {
  id  Int @id @default(autoincrement())
  registrationDate  DateTime  @default(now())
  description       String?
  status            Int @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  personId          Int
  persona           Persona @relation(fields: [personId] , references: [id])
}

model Legal_Entity {
  id  Int @id @default(autoincrement())
  NIT               String?
  companyName       String?
  address           String?
  registrationDate  DateTime
  legalRepresentive String?
  typeCompany       String?
  status            Int @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  personId          Int
  persona           Persona @relation(fields: [personId] , references: [id])
}

model City {
  id          Int @id   @default(autoincrement())
  description String  @unique
  person      Persona[]
  branchOffice Branch_Office[]
}

model Branch_Office {
  id          Int @id @default(autoincrement())
  name        String?
  address     String?
  phone       String?
  email       String?
  cityId      Int?
  city        City? @relation(fields: [cityId], references: [id])
  status      Int
  lawyer      Lawyer[]
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
}
//-------------------------------------------------------------------

model Provider {
  id Int @id @default(autoincrement())
  firstName String
  lastName  String
  NIT       String
  phone     String
  email     String
  address   String
  typeProvider  String?
  isActive  Boolean
  status    Int
  createAt  DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Clients {
  id Int @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String
  email     String
  NIT       String
  isActive  Boolean
  status    Int
  createAt  DateTime @default(now())
  updateAt  DateTime @updatedAt
} 

model External_personal {
  id        Int @id @default(autoincrement())
  firstName String?
  lastName  String?
  phone     String?
  email     String?
  type      Int
  description String
  status    Int
  dateOfBirth DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}